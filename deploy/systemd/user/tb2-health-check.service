[Unit]
Description=TB2 scheduled health check
Documentation=https://github.com/pingqLIN/terminal-bridge-v2
After=network.target

[Service]
Type=oneshot
# Example template: replace %h/dev/terminal-bridge-v2 with your installed repo path.
WorkingDirectory=%h/dev/terminal-bridge-v2
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 %h/dev/terminal-bridge-v2/tools/tb2_scheduled_health_check.py --skip-systemd --base-url http://127.0.0.1:3189 --log %h/.local/state/tb2/health-check.jsonl
